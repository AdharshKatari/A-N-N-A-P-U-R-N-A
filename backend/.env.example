[TEMPLATE]
# ====================================================================================
# FreshGuard Environment Configuration (.env.example)
# ====================================================================================

# 1. Google Gemini Vision LLM Credentials
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Weather & Atmospheric APIs (In-Transit Thermal degree-hours)
OPENWEATHER_API_KEY=your_openweather_api_key_here
WEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather

# 3. Geospatial & Satellite Services (ISRO VEDAS / Bhoonidhi & Maps)
ISRO_VEDAS_API_ENDPOINT=https://vedas.sac.gov.in/api/v1
ISRO_BHOONIDHI_USER_ID=your_isro_user_id_here
ISRO_BHOONIDHI_PASSWORD=your_isro_password_here


# 4. PostgreSQL 16 + PostGIS Spatial & TimescaleDB Data Warehouse
# IMPORTANT: Never commit real passwords to version control.
DB_USER=freshguard_admin
DB_PASSWORD=change_me_in_production
DB_NAME=freshguard_db
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql://freshguard_admin:change_me_in_production@localhost:5432/freshguard_db

# 5. Redis High-Speed Caching Layer
REDIS_URL=redis://localhost:6379/0

# 6. Server & Runtime Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# 7. FreeLLMAPI Unified AI Gateway
FREELLMAPI_KEY=your_freellmapi_key_here
FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_MODEL=gemini-2.5-flash

# 8. Cryptographic Passport Signing Key
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
# CRITICAL: Set this in production. Without it, QR tokens cannot be verified across restarts.
PASSPORT_HMAC_SECRET=your_secure_hmac_key_here

# 9. CORS Configuration
# Comma-separated list of allowed origins. Use "*" for development.
CORS_ORIGINS=*
