# ─── API Configuration ──────────────────────────────────
# Backend URL — change this to point to your production server.
# The app auto-detects platform (Android emulator uses 10.0.2.2),
# so you only need to set this for production or non-default setups.

# Local development (default if unset):
# EXPO_PUBLIC_API_URL=http://localhost:8000

# Production example:
# EXPO_PUBLIC_API_URL=https://your-api-production.up.railway.app

# Android emulator (already handled automatically):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
