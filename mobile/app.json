{
  "expo": {
    "name": "Annapurna",
    "slug": "annapurna",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1B7A3D"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.annapurna.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B7A3D"
      },
      "package": "com.annapurna.app"
    },
    "plugins": [
      "expo-camera",
      "expo-location",
      "expo-splash-screen",
      "expo-sqlite"
    ]
  }
}
