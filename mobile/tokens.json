{
  "$metadata": {
    "tokenSetOrder": ["global"]
  },
  "global": {
    "$description": "Annapurna Design System — Figma-compatible tokens for design handoff. Import via Tokens Studio plugin.",

    "color": {
      "brand": {
        "primary": {
          "$type": "color",
          "$value": "#1A4122",
          "$description": "Dark green — headings, key actions"
        },
        "primaryDark": {
          "$type": "color",
          "$value": "#00431D",
          "$description": "Deepest green — header accent, active states, primary buttons"
        },
        "secondary": {
          "$type": "color",
          "$value": "#2C5A33",
          "$description": "Medium green — icons, secondary accents"
        }
      },

      "background": {
        "default": {
          "$type": "color",
          "$value": "#FEF9F0",
          "$description": "Warm cream — screen background (every screen)"
        },
        "surface": {
          "$type": "color",
          "$value": "#FFFFFF",
          "$description": "White — cards, sheets, modals"
        },
        "surfaceAlt": {
          "$type": "color",
          "$value": "#F8F3EA",
          "$description": "Light cream — icon circle fills, subtle backgrounds"
        },
        "divider": {
          "$type": "color",
          "$value": "#E7E2D9",
          "$description": "Warm grey — card dividers, subtle borders, neutral card borders"
        },
        "dividerLight": {
          "$type": "color",
          "$value": "#F2EDE4",
          "$description": "Lighter divider — forecast rows, metric separators"
        }
      },

      "text": {
        "primary": {
          "$type": "color",
          "$value": "#1D1C16",
          "$description": "Near-black — headings, card titles, important values"
        },
        "secondary": {
          "$type": "color",
          "$value": "#404940",
          "$description": "Dark grey — body text, metadata, descriptions"
        },
        "muted": {
          "$type": "color",
          "$value": "#707A6F",
          "$description": "Medium grey — captions, tertiary info, icons"
        },
        "onPrimary": {
          "$type": "color",
          "$value": "#FFFFFF",
          "$description": "White — text on dark green buttons/cards"
        },
        "onDark": {
          "$type": "color",
          "$value": "#145C2E",
          "$description": "Dark green — text on light green chip backgrounds"
        }
      },

      "status": {
        "success": {
          "$type": "color",
          "$value": "#1B7A3D",
          "$description": "Healthy / positive"
        },
        "successBg": {
          "$type": "color",
          "$value": "#CCEAD0",
          "$description": "Light green chip/badge background"
        },
        "successLight": {
          "$type": "color",
          "$value": "#91F5A3",
          "$description": "Bright green — progress bars, active accents"
        },
        "warning": {
          "$type": "color",
          "$value": "#E8A317",
          "$description": "Amber — warnings, moderate risk, alerts"
        },
        "warningBg": {
          "$type": "color",
          "$value": "#FFF8E1",
          "$description": "Light amber card/badge background"
        },
        "warningIcon": {
          "$type": "color",
          "$value": "#FFA000",
          "$description": "Orange-amber — warning icons specifically"
        },
        "error": {
          "$type": "color",
          "$value": "#D32F2F",
          "$description": "Red — errors, high risk, critical warnings"
        },
        "errorBg": {
          "$type": "color",
          "$value": "#FFEBEE",
          "$description": "Light red badge background"
        },
        "info": {
          "$type": "color",
          "$value": "#1976D2",
          "$description": "Blue — informational (use sparingly)"
        },
        "infoBg": {
          "$type": "color",
          "$value": "#E3F2FD",
          "$description": "Light blue background"
        }
      },

      "chip": {
        "green": {
          "$type": "color",
          "$value": "#B1CEB4",
          "$description": "STABLE badge background"
        },
        "greenDark": {
          "$type": "color",
          "$value": "#334C39",
          "$description": "STABLE badge text"
        },
        "greenBright": {
          "$type": "color",
          "$value": "#78DB8C",
          "$description": "GOOD OPTION badge"
        },
        "greenText": {
          "$type": "color",
          "$value": "#005323",
          "$description": "GOOD OPTION badge text"
        },
        "greenLight": {
          "$type": "color",
          "$value": "#A4C1A8",
          "$description": "Support button background"
        }
      }
    },

    "spacing": {
      "xxs": {
        "$type": "dimension",
        "$value": "4px",
        "$description": "Tight inline gaps (dot + label, icon + text)"
      },
      "xs": {
        "$type": "dimension",
        "$value": "8px",
        "$description": "Small element gaps, internal chip padding"
      },
      "sm": {
        "$type": "dimension",
        "$value": "12px",
        "$description": "Action card gaps, list item gaps"
      },
      "md": {
        "$type": "dimension",
        "$value": "16px",
        "$description": "Normal card padding (small), internal content gaps"
      },
      "lg": {
        "$type": "dimension",
        "$value": "20px",
        "$description": "Screen horizontal padding, normal card padding"
      },
      "xl": {
        "$type": "dimension",
        "$value": "24px",
        "$description": "Large card padding, section gaps between related sections"
      },
      "xxl": {
        "$type": "dimension",
        "$value": "32px",
        "$description": "Major section gaps (different sections)"
      },
      "xxxl": {
        "$type": "dimension",
        "$value": "40px",
        "$description": "Reserved for major visual breaks"
      },
      "huge": {
        "$type": "dimension",
        "$value": "48px",
        "$description": "Rare — intentional large whitespace"
      },

      "layout": {
        "screenPadding": {
          "$type": "dimension",
          "$value": "20px",
          "$description": "Outer horizontal padding for ALL screens"
        },
        "cardPadding": {
          "$type": "dimension",
          "$value": "24px",
          "$description": "Standard card internal padding"
        },
        "cardPaddingSm": {
          "$type": "dimension",
          "$value": "20px",
          "$description": "Smaller card padding (weather, crop info)"
        },
        "sectionGap": {
          "$type": "dimension",
          "$value": "24px",
          "$description": "Gap between related content sections"
        },
        "majorSectionGap": {
          "$type": "dimension",
          "$value": "32px",
          "$description": "Gap between different major sections"
        },
        "headerPadding": {
          "$type": "dimension",
          "$value": "16px",
          "$description": "Vertical padding inside the top bar"
        }
      }
    },

    "borderRadius": {
      "sm": {
        "$type": "dimension",
        "$value": "12px",
        "$description": "Small components (badges, pills, small chips)"
      },
      "md": {
        "$type": "dimension",
        "$value": "16px",
        "$description": "Buttons, alerts, activity cards"
      },
      "lg": {
        "$type": "dimension",
        "$value": "24px",
        "$description": "Standard cards (most common)"
      },
      "xl": {
        "$type": "dimension",
        "$value": "28px",
        "$description": "Large cards, prominent buttons, pill CTAs"
      },
      "xxl": {
        "$type": "dimension",
        "$value": "32px",
        "$description": "Large containers, modals"
      },
      "full": {
        "$type": "dimension",
        "$value": "9999px",
        "$description": "Fully rounded (avatar circles, pill shapes)"
      }
    },

    "fontFamily": {
      "regular": {
        "$type": "fontFamily",
        "$value": "PlusJakartaSans_400Regular",
        "$description": "Regular weight (400)"
      },
      "medium": {
        "$type": "fontFamily",
        "$value": "PlusJakartaSans_500Medium",
        "$description": "Medium weight (500)"
      },
      "semibold": {
        "$type": "fontFamily",
        "$value": "PlusJakartaSans_600SemiBold",
        "$description": "Semibold weight (600)"
      },
      "bold": {
        "$type": "fontFamily",
        "$value": "PlusJakartaSans_700Bold",
        "$description": "Bold weight (700)"
      }
    },

    "typography": {
      "display": {
        "$type": "typography",
        "$value": {
          "fontFamily": "PlusJakartaSans_700Bold",
          "fontWeight": "700",
          "fontSize": "32px",
          "lineHeight": "40px",
          "letterSpacing": "-0.02em"
        },
        "$description": "App logo, hero metrics"
      },
      "h1": {
        "$type": "typography",
        "$value": {
          "fontFamily": "PlusJakartaSans_600SemiBold",
          "fontWeight": "600",
          "fontSize": "28px",
          "lineHeight": "34px"
        },
        "$description": "Page titles, greetings"
      },
      "h2": {
        "$type": "typography",
        "$value": {
          "fontFamily": "PlusJakartaSans_700Bold",
          "fontWeight": "700",
          "fontSize": "24px",
          "lineHeight": "30px"
        },
        "$description": "Section headings, weather temp"
      },
      "h3": {
        "$type": "typography",
        "$value": {
          "fontFamily": "PlusJakartaSans_600SemiBold",
          "fontWeight": "600",
          "fontSize": "24px",
          "lineHeight": "30px"
        },
        "$description": "Card titles, market section headers"
      },
      "h4": {
        "$type": "typography",
        "$value": {
          "fontFamily": "PlusJakartaSans_600SemiBold",
          "fontWeight": "600",
          "fontSize": "21px",
          "lineHeight": "26px"
        },
        "$description": "Header titles, card headings"
      },
      "bodyLg": {
        "$type": "typography",
        "$value": {
          "fontFamily": "PlusJakartaSans_600SemiBold",
          "fontWeight": "600",
          "fontSize": "18px",
          "lineHeight": "24px"
        },
        "$description": "Emphasized body, metric values"
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "PlusJakartaSans_400Regular",
          "fontWeight": "400",
          "fontSize": "16px",
          "lineHeight": "24px"
        },
        "$description": "Standard body text, button labels"
      },
      "bodyBold": {
        "$type": "typography",
        "$value": {
          "fontFamily": "PlusJakartaSans_600SemiBold",
          "fontWeight": "600",
          "fontSize": "16px",
          "lineHeight": "22px"
        },
        "$description": "Button labels, action card titles"
      },
      "bodyMd": {
        "$type": "typography",
        "$value": {
          "fontFamily": "PlusJakartaSans_400Regular",
          "fontWeight": "400",
          "fontSize": "15px",
          "lineHeight": "22px"
        },
        "$description": "Secondary body, alert text"
      },
      "bodyMdBold": {
        "$type": "typography",
        "$value": {
          "fontFamily": "PlusJakartaSans_600SemiBold",
          "fontWeight": "600",
          "fontSize": "15px",
          "lineHeight": "22px"
        },
        "$description": "Crop titles, metric values"
      },
      "caption": {
        "$type": "typography",
        "$value": {
          "fontFamily": "PlusJakartaSans_400Regular",
          "fontWeight": "400",
          "fontSize": "14px",
          "lineHeight": "20px"
        },
        "$description": "Secondary text, descriptions"
      },
      "captionBold": {
        "$type": "typography",
        "$value": {
          "fontFamily": "PlusJakartaSans_600SemiBold",
          "fontWeight": "600",
          "fontSize": "14px",
          "lineHeight": "20px"
        },
        "$description": "Indicator labels, badge text"
      },
      "small": {
        "$type": "typography",
        "$value": {
          "fontFamily": "PlusJakartaSans_400Regular",
          "fontWeight": "400",
          "fontSize": "13px",
          "lineHeight": "18px"
        },
        "$description": "Metadata, location, timestamps"
      },
      "label": {
        "$type": "typography",
        "$value": {
          "fontFamily": "PlusJakartaSans_700Bold",
          "fontWeight": "700",
          "fontSize": "12px",
          "lineHeight": "16px"
        },
        "$description": "Badge text, forecast labels"
      },
      "labelSm": {
        "$type": "typography",
        "$value": {
          "fontFamily": "PlusJakartaSans_700Bold",
          "fontWeight": "700",
          "fontSize": "11px",
          "lineHeight": "14px"
        },
        "$description": "Uppercase badges (STABLE, GOOD OPTION)"
      }
    },

    "shadow": {
      "card": {
        "$type": "shadow",
        "$value": {
          "x": "0",
          "y": "4",
          "blur": "20",
          "spread": "0",
          "color": "#145C2E",
          "opacity": "6%"
        },
        "$description": "Standard card shadow — subtle elevation"
      },
      "header": {
        "$type": "shadow",
        "$value": {
          "x": "0",
          "y": "4",
          "blur": "20",
          "spread": "0",
          "color": "#145C2E",
          "opacity": "6%"
        },
        "$description": "Top bar — very subtle lift"
      },
      "button": {
        "$type": "shadow",
        "$value": {
          "x": "0",
          "y": "2",
          "blur": "4",
          "spread": "0",
          "color": "#000000",
          "opacity": "10%"
        },
        "$description": "Interactive elements — slightly stronger"
      },
      "banner": {
        "$type": "shadow",
        "$value": {
          "x": "0",
          "y": "4",
          "blur": "16",
          "spread": "0",
          "color": "#145C2E",
          "opacity": "15%"
        },
        "$description": "Dark recommendation cards — stronger"
      }
    }
  }
}
