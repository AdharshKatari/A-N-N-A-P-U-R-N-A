{
  "name": "the-farmer-market",
  "version": "1.0.0",
  "description": "Annapurna FreshGuard - AI-Powered Post-Harvest Intelligence & Agri Logistics Web/Mobile App",
  "scripts": {
    "start": "npm --prefix mobile run start --",
    "start:offline": "npm --prefix mobile run start:offline --",
    "android": "npm --prefix mobile run android --",
    "ios": "npm --prefix mobile run ios --",
